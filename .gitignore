# ============================================================
# GENERAL .gitignore — DO NOT ADD FOLDER-SPECIFIC RULES HERE
# Each folder (ahmad/, ramy/, Hani/, ramon/, Grid-Finding/,
# hcad/, Final-Search-ML-Pipeline/) has its own .gitignore.
# Add your ignore rules there, not here.
# ============================================================

# Virtual environment
encoding/
etc/
include/
lib/
scripts/
share/
.venv/
venv/
env/

# Python cache
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Jupyter — track notebooks but ignore checkpoints
.ipynb_checkpoints/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Previous workflows — archived, already in git history
# previous_workflows/

# Datasets (download manually)
datasets/

# Course assets — PDFs, images, not code
assets/

# Large CSV files at repo root
harris_county_building_data.csv
